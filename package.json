{
  "name": "dsh-rulebook",
  "version": "1.1.0",
  "type": "module",
  "description": "常驻规则（人工写入通道）：三层规则文件每步注入系统提示词，写入只走 /rule 斜杠命令，模型侧没有写入通道。",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xincy22/dsh-rulebook-plugin.git"
  }
}